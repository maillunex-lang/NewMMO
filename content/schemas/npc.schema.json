{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/npc.schema.json",
  "title": "NPC",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "npc"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^NPC-\\d{3}$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "faction": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "first_chapter": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
