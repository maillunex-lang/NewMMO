{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/quest_item.schema.json",
  "title": "Quest item",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "quest_item"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ITEM-(Q-0[1-6]-\\d\\d|SQ-0[1-6]-\\d{3})$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
