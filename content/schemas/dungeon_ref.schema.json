{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/dungeon_ref.schema.json",
  "title": "Dungeon catalog reference (03)",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "dungeon_ref"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^DNG-0[1-6]-00[12]$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "name",
        "level"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    }
  }
}
