{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/chapter.schema.json",
  "title": "Chapter",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "chapter"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^CH-0[1-6]$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "title",
        "region"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "pattern": "^REG-0[1-6]$"
        }
      }
    }
  }
}
