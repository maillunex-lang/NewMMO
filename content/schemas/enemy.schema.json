{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/enemy.schema.json",
  "title": "Enemy",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "enemy"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ENM-0[1-6]-(00[1-8]|10[1-3]|20[1-2]|30[1-2]|401)$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "name",
        "level",
        "ai",
        "spawn_refs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "threat": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "ai": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "type": "string",
          "minLength": 1
        },
        "spawn_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(SPAWN|SPX|DNG|EVT)-\\d\\d-\\d{3}$"
          }
        }
      }
    }
  }
}
