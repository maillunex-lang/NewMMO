{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/scene.schema.json",
  "title": "Scene",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "scene"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^SCN-[A-Z0-9-]+$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
