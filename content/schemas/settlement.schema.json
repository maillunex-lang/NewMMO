{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/settlement.schema.json",
  "title": "Settlement",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "settlement"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^STL-0[1-6]-0[1-3]$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "name",
        "region"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "pattern": "^REG-0[1-6]$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
