{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/dialogue_template.schema.json",
  "title": "Dialogue template (DIA.NPC.*)",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "dialogue_template"
    },
    "id": {
      "type": "string",
      "pattern": "^DIA\\.NPC\\.\\*\\.[A-Z]+\\.[A-Z]+$"
    },
    "file": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}