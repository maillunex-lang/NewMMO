{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/location.schema.json",
  "title": "Location",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "location"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^LOC-0[1-6]-\\d{3}$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "pvp": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
