{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/item_set.schema.json",
  "title": "Equipment set",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "item_set"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^SET-0[1-5]-0[1-6]$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
