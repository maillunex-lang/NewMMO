{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/faction.schema.json",
  "title": "Faction",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "faction"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^FAC-0[1-8]$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
