{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/content/event.schema.json",
  "title": "World event",
  "type": "object",
  "required": [
    "kind",
    "id",
    "file",
    "line",
    "fields"
  ],
  "properties": {
    "kind": {
      "const": "event"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^EVT-0[1-6]-00[1-3]$"
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "world_boss": {
          "type": "string",
          "pattern": "^ENM-0[1-6]-401$"
        }
      }
    }
  }
}
