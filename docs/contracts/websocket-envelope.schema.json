{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newmmo/contracts/websocket-envelope.schema.json",
  "title": "NewMMO WebSocket envelope v1 (see websocket-protocol.md §2)",
  "definitions": {
    "client_to_server": {
      "type": "object",
      "required": ["protocol_version", "type", "payload"],
      "properties": {
        "protocol_version": { "const": 1 },
        "type": { "type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)+$" },
        "request_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "payload": { "type": "object" }
      }
    },
    "server_to_client": {
      "type": "object",
      "required": ["protocol_version", "type", "session_id", "server_time", "revision", "trace_id", "payload"],
      "properties": {
        "protocol_version": { "const": 1 },
        "type": { "type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)+$" },
        "request_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "session_id": { "type": "string", "minLength": 1 },
        "server_time": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d{1,3})?Z$" },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "trace_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "payload": { "type": "object" }
      }
    }
  }
}
