; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lunex MMORPG"
config/description="Dawn Valley Stage 1 vertical slice"
run/main_scene="res://scenes/world/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/portrait_player.png"

[autoload]

AssetPacks="*res://scripts/core/asset_pack.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/lunex_world_studio/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://translations/ui.ru.translation", "res://translations/ui.en.translation")
locale/fallback="ru"
locale/locale="ru"

[layer_names]

2d_physics/layer_1="world"

[physics]

2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
